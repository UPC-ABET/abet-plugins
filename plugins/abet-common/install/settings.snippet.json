{
  "_comment": "Merge into the consuming repo's .claude/settings.json. Plugins cannot ship permissions, so this is a snippet, not a live component. Apply it with: node install/apply-settings.mjs <repo-path>. These entries are convenience — they cut permission prompts for things you would approve anyway. The real boundary is the PreToolUse hooks, which cannot be bypassed from settings.",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git blame:*)",
      "Bash(git stash list:*)",
      "Bash(git mv:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh auth status:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Read(./openspec/**)",
      "Read(./docs/**)",
      "Edit(./openspec/**)",
      "Write(./openspec/**)",
      "Edit(./docs/CONTEXT.md)",
      "Edit(./docs/adr/**)",
      "Write(./docs/adr/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./docs/POLICIES.md)",
      "Write(./docs/POLICIES.md)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)"
    ]
  }
}
